{
  "name": "@park-ui/qwik",
  "type": "module",
  "private": true,
  "scripts": {
    "codegen": "panda codegen --clean --silent",
    "dev": "vite --mode ssr",
    "lint": "biome lint ./src",
    "typecheck": "bun run codegen && tsc",
    "test": "bun run codegen && vitest run",
    "test:browser": "bun run codegen && vitest run --config vitest.browser.config.ts",
    "e2e": "node e2e/checkbox.e2e.mjs"
  },
  "exports": {
    ".": "./src/components/ui/index.ts"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@park-ui/preset": "workspace:*",
    "@qwik.dev/core": "2.0.0-rc.4",
    "@qwik.dev/router": "2.0.0-rc.4",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "pandacss-plugin-qwik": "github:gabrielgrant/pandacss-plugin-qwik#release/v0.3.2",
    "playwright": "1.58.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.8",
    "vitest-browser-qwik": "0.3.11"
  },
  "peerDependencies": {
    "@ark-ui/qwik": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@ark-ui/qwik": {
      "optional": true
    }
  }
}
